{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes-harness/schemas/hermes.async_job_intent/0.2",
  "title": "Hermes async job immutable intent 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "async_job_id", "task_id", "contract_sha256", "adapter_id", "provider_id", "idempotency_key", "request_sha256", "budget_cny", "created_at", "state", "third_party_success_is_hermes_completion"],
  "properties": {
    "schema_identity": { "$ref": "#/$defs/schema_identity" },
    "async_job_id": { "type": "string", "pattern": "^async-job-[a-f0-9]{16}$" },
    "task_id": { "type": "string", "minLength": 3 },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "adapter_id": { "type": "string", "minLength": 3 },
    "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "idempotency_key": { "$ref": "#/$defs/sha256" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "budget_cny": { "type": "number", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "state": { "const": "prepared" },
    "third_party_success_is_hermes_completion": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "schema_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "version", "sha256"],
      "properties": {
        "schema_id": { "const": "hermes.async_job_intent" },
        "version": { "const": "0.2" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
