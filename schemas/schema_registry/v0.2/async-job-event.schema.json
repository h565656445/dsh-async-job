{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes-harness/schemas/hermes.async_job_event/0.2",
  "title": "Hermes async job authoritative event 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "sequence", "event_id", "timestamp", "event_type", "async_job_id", "intent_sha256", "contract_sha256", "provider_id", "provider_job_ref", "observation_event_id", "observed_provider_id", "observed_intent_sha256", "observed_contract_sha256", "observed_state", "trusted_source", "changes_state", "from_state", "to_state", "reason", "hermes_completed"],
  "properties": {
    "schema_identity": { "$ref": "#/$defs/schema_identity" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^async-event-[a-f0-9]{16}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": { "enum": ["job_prepared", "job_submitted", "provider_running", "provider_succeeded", "provider_failed", "outcome_unknown", "security_callback_rejected", "job_reconciled"] },
    "async_job_id": { "type": "string", "pattern": "^async-job-[a-f0-9]{16}$" },
    "intent_sha256": { "$ref": "#/$defs/sha256" },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "provider_job_ref": { "type": ["string", "null"], "minLength": 3 },
    "observation_event_id": { "type": ["string", "null"], "minLength": 3 },
    "observed_provider_id": { "type": ["string", "null"], "minLength": 3 },
    "observed_intent_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "observed_contract_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "observed_state": { "type": ["string", "null"], "enum": [null, "running", "succeeded", "failed", "unknown"] },
    "trusted_source": { "type": "boolean" },
    "changes_state": { "type": "boolean" },
    "from_state": { "type": ["string", "null"], "enum": [null, "prepared", "submitted", "running", "provider_succeeded", "provider_failed", "outcome_unknown", "reconciled"] },
    "to_state": { "enum": ["prepared", "submitted", "running", "provider_succeeded", "provider_failed", "outcome_unknown", "reconciled"] },
    "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
    "hermes_completed": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "schema_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "version", "sha256"],
      "properties": {
        "schema_id": { "const": "hermes.async_job_event" },
        "version": { "const": "0.2" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
